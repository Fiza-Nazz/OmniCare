# ==============================================================================
# OmniCare — Environment Variables Example Configuration
# NOTE: This file contains strictly synthetic / safe placeholders for local dev.
# Never commit actual production secrets or credentials to the repository.
# ==============================================================================

# Core App Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME=OmniCare
APP_PORT=8000
APP_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL 16)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=omnicare_dev
DATABASE_USER=omnicare_user
DATABASE_PASSWORD=change_this_dev_password_in_local_env
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Cache & Session Storage
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security & Cryptography (Generate secure random 256-bit strings for local .env)
SECRET_KEY=change_this_to_a_secure_random_string_in_your_local_env_file
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Audit & Logging
LOG_LEVEL=INFO
ENABLE_JSON_LOGGING=true
MASK_SENSITIVE_DATA=true

# Frontend Web Application (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
